{
  "name": "emily-skill-cli",
  "version": "26.4.1",
  "description": "Install Oracle skills to Claude Code and AI coding agents — emily-oracle edition",
  "type": "module",
  "bin": {
    "emily-skill-cli": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "compile": "bun run scripts/compile.ts",
    "calver": "bun run scripts/calver.ts",
    "test": "bun test __tests__/",
    "version": "bun run compile && bun run scripts/update-readme-table.ts && git add -A",
    "prepublishOnly": "bun run compile && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "oracle",
    "emily-oracle",
    "agent",
    "ai"
  ],
  "author": "doctorboyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doctorboyz/emily-skill-cli.git"
  }
}