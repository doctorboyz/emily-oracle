# ─── Reader (macmini, Docker) ───────────────────────────────────────────
# Primary file backend = iCloud Drive, bind-mounted into the container.
# sources.json uses type:"local" pointing at /files/icloud (see docker-compose.yml).
SOURCES_FILE=/data/sources.json
DB_PATH=/data/annotations.db
PORT=3000

# Allowed extensions for local-source reads (default below)
LOCAL_ALLOW_EXT=.md,.markdown,.txt,.png,.jpg,.jpeg

# ─── (ทางเลือก) Agent — สำหรับไฟล์นอก iCloud บนเครื่องอื่น ───────────────
# ROOTS=~/notes,~/Code
# TOKEN=change-me-long-random
# BIND=100.121.113.38      # Tailscale IP ของเครื่องนั้น (ไม่ใช่ 0.0.0.0)
# PORT=7801
# ALLOW_EXT=.md,.markdown,.txt,.png,.jpg,.jpeg