    "highlight.js": "^11.11.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/better-sqlite3": "^7.6.12",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
